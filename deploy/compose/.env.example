# hikifune
HIKIFUNE_LISTEN=:8869
HIKIFUNE_DATA=/data
HIKIFUNE_KEEP_RUNS=60
HIKIFUNE_TIMEZONE=
HIKIFUNE_CHECK_AT=00:00
HIKIFUNE_UPDATE_AT=01:00
HIKIFUNE_WATCH=2m

# hikifune-agent
HIKIFUNE_AGENT_LISTEN=:8870
HIKIFUNE_AGENT_TOKEN=
HIKIFUNE_DOCKER_HOST=unix:///var/run/docker.sock
HIKIFUNE_DOCKER_CONFIG=
HIKIFUNE_INSECURE_REGISTRIES=
